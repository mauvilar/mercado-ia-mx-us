# developer.adzuna.com -> registro gratuito
# La misma llave sirve para los ~19 países de Adzuna: los de calibración de
# config/countries.yml no piden credenciales aparte.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ~/.kaggle/kaggle.json
KAGGLE_USERNAME=
KAGGLE_KEY=

# developer.usajobs.gov -> registro gratuito.
# Vacantes federales de EE.UU. con salario real en el 100 % de las filas.
# El correo es el que usaste para registrarte: la API lo exige en el User-Agent.
USAJOBS_EMAIL=
USAJOBS_API_KEY=

# jooble.org/api/about -> llave gratuita bajo solicitud.
# Agregador con cobertura mexicana. OJO: mezcla salarios publicados por el empleador
# con estimaciones propias sin distinguirlos, así que todo lo suyo pasa por la
# compuerta de src/data/salario_texto.py antes de contar como observado.
JOOBLE_API_KEY=
